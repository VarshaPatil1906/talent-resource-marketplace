# Application Port
SERVER_PORT=8080

# Active Spring Profile (mysql or default)
SPRING_PROFILES_ACTIVE=default

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talent_marketplace
DB_USER=root
DB_PASSWORD=rootpassword

# Spring Security Passwords (Override in production)
SECURITY_MANAGER_PASSWORD=managerpass
SECURITY_RECRUITER_PASSWORD=recruiterpass
SECURITY_ADMIN_PASSWORD=adminpass

# Optional External AI API Key (Simulated AI agent used when absent)
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
